# Copy to .env and fill in. .env is gitignored and must never be committed —
# this repository is public.
#
#   cp .env.example .env
#
# Load into your shell before any step that calls the API:
#
#   set -a; source .env; set +a
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Model used for both baseline and agent. Pinned for reproducibility —
# the baseline and every iteration must run on the same model to keep
# the comparison fair (plan.md §5).
MODEL_ID=claude-sonnet-5

# Deterministic runs. Do not change between baseline and final.
TEMPERATURE=0
CORPUS_SEED=42
