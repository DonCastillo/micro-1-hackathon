# Copy to .env and fill in. .env is gitignored and must never be committed —
# this repository is public.
#
#   cp .env.example .env
#
# Load into your shell before any step that calls the API:
#
#   set -a; source .env; set +a
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Model used for both baseline and agent. Pinned for reproducibility —
# the baseline and every iteration must run on the same model to keep
# the comparison fair (plan.md §5).
MODEL_ID=claude-sonnet-5

# Reasoning depth and token spend: low | medium | high | xhigh | max.
# There is no temperature setting on this model generation — sampling
# parameters were removed and sending one returns a 400. Effort is the
# equivalent dial. Hold it constant across baseline and every iteration,
# same fairness rule as MODEL_ID (plan.md §5).
EFFORT=medium

# Seeds the corpus injector. Same seed -> byte-identical corpus, which is
# what lets a judge regenerate the benchmark exactly. Costs no API calls.
CORPUS_SEED=42
